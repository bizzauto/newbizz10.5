{
  "name": "Support Ticket Triage",
  "nodes": [
    {
      "id": "1",
      "name": "Support Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 1,
      "position": [250, 300],
      "webhookId": "support-triage-webhook",
      "parameters": {
        "httpMethod": "POST",
        "path": "support-ticket",
        "responseMode": "onReceived"
      }
    },
    {
      "id": "2",
      "name": "Classify Priority (AI)",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [470, 300],
      "parameters": {
        "language": "javaScript",
        "jsCode": "const body = $input.first().json.body;\nconst text = (body.subject + ' ' + body.description).toLowerCase();\nlet priority = 'low';\nif (/urgent|down|outage|critical|breach/.test(text)) priority = 'high';\nelse if (/error|broken|cannot|failed/.test(text)) priority = 'medium';\nreturn [{ json: { ...body, priority } }];"
      }
    },
    {
      "id": "3",
      "name": "Route by Priority",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [690, 300],
      "parameters": {
        "conditions": {
          "options": { "caseSensitive": true },
          "combinator": "and",
          "conditions": [
            {
              "id": "c1",
              "leftValue": "={{ $json.priority }}",
              "operator": { "type": "string", "operation": "equals" },
              "rightValue": "high"
            }
          ]
        }
      }
    },
    {
      "id": "4",
      "name": "Set SLA Timer",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [910, 400],
      "parameters": {
        "assignments": {
          "assignments": [
            { "id": "a", "name": "sla_due", "type": "string", "value": "={{ $now.plus({ hours: 1 }).toISO() }}" },
            { "id": "b", "name": "sla_minutes", "type": "number", "value": 60 }
          ]
        }
      }
    },
    {
      "id": "5",
      "name": "Escalate to Tier 2",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [1130, 300],
      "parameters": {
        "method": "POST",
        "url": "https://helpdesk.bizzauto.app/api/tickets/escalate",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={ \"ticket_id\": \"{{ $json.id }}\", \"priority\": \"{{ $json.priority }}\", \"sla_due\": \"{{ $json.sla_due }}\" }"
      }
    }
  ],
  "connections": {
    "Support Webhook": {
      "main": [ [ { "node": "Classify Priority (AI)", "type": "main", "index": 0 } ] ]
    },
    "Classify Priority (AI)": {
      "main": [ [ { "node": "Route by Priority", "type": "main", "index": 0 } ] ]
    },
    "Route by Priority": {
      "main": [
        [ { "node": "Escalate to Tier 2", "type": "main", "index": 0 } ],
        [ { "node": "Set SLA Timer", "type": "main", "index": 0 } ]
      ]
    },
    "Set SLA Timer": {
      "main": [ [ { "node": "Escalate to Tier 2", "type": "main", "index": 0 } ] ]
    }
  }
}
