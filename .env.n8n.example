# n8n integration (self-hosted automation engine)

# --- n8n API (used by src/server/services/n8n.service.ts and routes/n8n.ts) ---
# Base URL of your n8n instance (no trailing slash)
N8N_BASE_URL=http://localhost:5678
# API key created in n8n -> Settings -> API keys
N8N_API_KEY=your-n8n-api-key

# --- Legacy trigger path (used by LeadCaptureService.triggerN8nWorkflow) ---
# Same instance; posts to {N8N_URL}/webhook/{workflowId}
N8N_URL=http://localhost:5678

# --- docker-compose.n8n.yml overrides (only needed when running the bundled stack) ---
# N8N_WEBHOOK_URL=https://n8n.your-domain.com/
# N8N_ENCRYPTION_KEY=change-me-to-a-long-random-string
# DB_HOST=postgres
# DB_PORT=5432
# DB_NAME=bizzauto
# DB_USER=bizzauto
# DB_PASSWORD=bizzauto
# REDIS_HOST=redis
# REDIS_PORT=6379
